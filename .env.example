# ===================================================
# CONFIGURACIÓN DEL SISTEMA DE INVENTARIO MILITAR TIC
# ===================================================

# Configuración del Servidor Express / Node.js
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Base de Datos con Sequelize (PostgreSQL por defecto, compatible con MySQL)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mil_inventory_db
DB_USER=mil_admin
DB_PASSWORD=SecureMilPass2026!
DB_LOGGING=false

# Para cambiar a MySQL (descomentar estas líneas si prefieres MySQL en lugar de PostgreSQL):
# DB_DIALECT=mysql
# DB_PORT=3306
# DB_NAME=mil_inventory_db
# DB_USER=root
# DB_PASSWORD=SecureMilPass2026!

# Seguridad, JWT y Criptografía Militar
JWT_SECRET=TACTICAL_MIL_COMSEC_JWT_SECRET_KEY_984729184
JWT_EXPIRES_IN=8h
SALT_ROUNDS=12

# Clasificación de Seguridad Mínima para Terminal
SECURITY_CLASSIFICATION_LEVEL=TOP_SECRET

# Claves de Integración Opcionales
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

